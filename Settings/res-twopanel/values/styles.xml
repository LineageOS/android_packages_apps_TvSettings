<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Override the Theme.Settings.Transparent to TwoPanel style. -->
    <style name="TvSettingsActivityTheme" parent="Theme.Settings.TwoPanel" />

    <style name="Theme.Settings.TwoPanel" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/SettingsWindowAnimationStyle</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.8</item>
        <item name="preferenceTheme">@style/TwoPanelPreferenceTheme</item>
        <item name="guidedStepTheme">@style/Theme.Settings.GuidedStepHighContrast</item>
        <item name="android:alertDialogTheme">@style/TvSettingsDialog</item>
   </style>

   <!-- The theme used for Connectivity in AndroidManifest allowing overlay. -->
   <style name="TvSettingsConnectivityTheme" parent="Theme.TwoPanelSettingsConnectivity" />

   <!-- Settings theme for connectivity -->
   <style name="Theme.TwoPanelSettingsConnectivity" parent="@style/Theme.Settings.TwoPanel">
        <item name="guidedStepTheme">@style/ConnectivityGuidedStepFragmentThemeTwoPanel</item>
        <item name="android:windowBackground">@drawable/connectivity_background</item>
        <item name="android:fontFamily">@font/brand_font</item>
   </style>

   <!-- The theme used for Connectivity Text Input allowing overlay. -->
   <style name="ConnectivityTextInput" parent="ConnectivityTextInputTwoPanel" />

   <style name="ConnectivityTextInputTwoPanel">
        <item name="android:fontFamily">@font/brand_font</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textCursorDrawable">@drawable/setup_text_input_cursor</item>
        <item name="android:textColor">#FF001222</item>
        <item name="android:textSize">16sp</item>
    </style>


    <!-- The style used for Connectivity Text Input Wrapper allowing overlay. -->
    <style name="ConnectivityTextBackgroundStyle" parent="ConnectivityTextInputWrapperTwoPanel" />

    <style name="ConnectivityTextInputWrapperTwoPanel">
        <item name="android:background">@drawable/setup_text_input_background_two_panel</item>
        <item name="android:layout_height">48dp</item>
    </style>

    <!-- Override the Bluetooth Theme to TwoPanel style. -->
    <style name="BluetoothAccessoryTheme" parent="TwoPanelBluetoothAccessoryTheme" />
</resources>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/main_frame"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="?android:attr/windowBackground"
              android:orientation="vertical"
              android:paddingStart="@dimen/tp_preference_fragment_start_padding"
              android:transitionGroup="false">

    <RelativeLayout
        android:id="@+id/decor_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tp_preference_decor_container_margin_bottom"
        android:paddingBottom="@dimen/tp_preference_decor_title_padding_bottom"
        android:paddingStart="@dimen/tp_preference_decor_start_padding"
        android:background="@android:color/transparent"
        android:elevation="@dimen/lb_preference_decor_title_container_elevation"
        android:transitionGroup="false">
        <com.android.tv.twopanelsettings.SmoothScalingTextView
            android:id="@+id/decor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?android:attr/titleTextStyle"
            android:includeFontPadding="true"
            android:singleLine="false"
            android:autoSizeTextType="uniform"
            android:hyphenationFrequency="full"
            android:maxLines="3"/>
        <TextView
            android:id="@android:id/message"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_below="@id/decor_title"
            android:layout_alignStart="@id/decor_title"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:includeFontPadding="true"
            style="@style/TextAppearance.TwoPanelPreference.Subtitle"/>
    </RelativeLayout>

    <androidx.leanback.widget.VerticalGridView
        android:id="@android:id/list"
        android:paddingStart="35dp"
        android:paddingTop="5dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionGroup="true"/>

</LinearLayout>

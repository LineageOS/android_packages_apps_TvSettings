<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Advanced restart menu -->
    <!-- Title for reboot confirmation in Restart Options dialog [CHAR LIMIT=50] -->
    <string name="advanced_restart_confirm_title">Restart?</string>
    <!-- Summary for reboot confirmation in Restart Options dialog [CHAR LIMIT=50] -->
    <string name="advanced_restart_confirm_summary">Choose a destination</string>
    <!-- Button to restart the device, within the Restart Options dialog -->
    <string name="global_action_restart_system">System</string>
    <!-- Button to restart the device into recovery mode, within the Restart Options dialog -->
    <string name="global_action_restart_recovery">Recovery</string>
    <!-- Button to restart the device into userspace fastboot, within the Restart Options dialog -->
    <string name="global_action_restart_fastboot">Fastbootd</string>
    <!-- Button to restart the device into bootloader mode, within the Restart Options dialog -->
    <string name="global_action_restart_bootloader">Bootloader</string>

    <!-- [CHAR LIMIT=NONE] Device Info screen. Countdown for user taps to enable development settings -->
    <plurals name="show_dev_countdown_cm">
        <item quantity="one">You are now <xliff:g id="step_count">%1$d</xliff:g> step away from enabling development settings.</item>
        <item quantity="other">You are now <xliff:g id="step_count">%1$d</xliff:g> steps away from enabling development settings.</item>
    </plurals>
    <!-- [CHAR LIMIT=NONE] Device Info screen. Confirmation that developer settings are enabled -->
    <string name="show_dev_on_cm">You have enabled development settings!</string>
    <!-- [CHAR LIMIT=NONE] Device Info screen. Okay we get it, stop pressing, you already have it on -->
    <string name="show_dev_already_cm">No need, you have already enabled development settings.</string>

    <!-- Adb root access -->
    <string name="enable_adb_root">Rooted debugging</string>
    <string name="enable_adb_root_summary">Allow running Android debugging as root</string>

    <!-- Advanced restart options -->
    <string name="advanced_restart_title">Advanced restart</string>
    <string name="advanced_restart_summary">Show options for restarting into recovery, bootloader or performing a soft restart</string>

    <!-- Android debugging over network -->
    <string name="adb_over_network">ADB over network</string>
    <string name="adb_over_network_summary">Enable TCP/IP debugging over network interfaces (Wi\u2011Fi, USB networks). This setting is reset on reboot</string>
    <string name="adb_over_network_warning">WARNING: When ADB over network is enabled, your phone is open for intrusions on all connected networks!\n\nOnly use this feature when you are connected on trusted networks.\n\nDo you really want to enable this function?</string>

    <!-- Buttons screen -->
    <string name="system_buttons">Buttons</string>
    <!-- Power button press and hold action behavior. [CHAR LIMIT=60] -->
    <string name="power_button_long_press_action_title">Power button long press action</string>
    <!-- Power button long press action to access the Power Menu. [CHAR LIMIT=60] -->
    <string name="power_button_long_press_for_power_menu_action">Access Power menu</string>
    <!-- Power button long press action to open Assistant. [CHAR LIMIT=60] -->
    <string name="power_button_long_press_for_assistant_action">Open Assistant</string>
    <!-- Volume up and down to mute [CHAR LIMIT=60] -->
    <string name="press_volume_up_and_down_to_mute_title">Two button mute</string>
    <string name="press_volume_up_and_down_to_mute_summary">Press the volume up and down buttons to toggle audio mute</string>

    <!-- Remote shortcut buttons, such as streaming app buttons [CHAR LIMIT=60] -->
    <string name="shortcut_buttons_title">Shortcut buttons</string>
    <string name="shortcut_buttons_summary">Choose what remote shortcut buttons, such as app buttons, do</string>
    <!-- Title of a shortcut button, %1$s is its name, e.g. Netflix [CHAR LIMIT=40] -->
    <string name="shortcut_button_title"><xliff:g id="name" example="Netflix">%1$s</xliff:g> button</string>
    <!-- Default action of a shortcut button, %1$s is the name of what it opens [CHAR LIMIT=60] -->
    <string name="shortcut_button_default">Default: open <xliff:g id="name" example="Netflix">%1$s</xliff:g></string>
    <string name="shortcut_button_default_missing">Default: open <xliff:g id="name" example="Netflix">%1$s</xliff:g> (not installed)</string>
    <string name="shortcut_button_none">Do nothing</string>
    <string name="shortcut_button_send_key">Send a key</string>
    <string name="shortcut_button_open_app">Open an app</string>
    <!-- Keys that a shortcut button can send instead [CHAR LIMIT=30] -->
    <string name="shortcut_button_key_play_pause">Play/pause</string>
    <string name="shortcut_button_key_stop">Stop</string>
    <string name="shortcut_button_key_next">Next</string>
    <string name="shortcut_button_key_previous">Previous</string>
    <string name="shortcut_button_key_rewind">Rewind</string>
    <string name="shortcut_button_key_fast_forward">Fast forward</string>
    <string name="shortcut_button_key_mute">Mute</string>
    <string name="shortcut_button_key_assist">Assistant</string>
    <string name="shortcut_button_key_home">Home</string>
    <string name="shortcut_button_key_back">Back</string>
    <string name="shortcut_button_key_menu">Menu</string>
    <string name="shortcut_button_key_guide">Guide</string>
    <string name="shortcut_button_key_captions">Captions</string>

    <!-- Option to enable CEC volume control [CHAR LIMIT=30] -->
    <string name="inputs_volume_control_enabled">CEC Volume Control</string>
    <!-- Description of CEC volume control [CHAR LIMIT=50] -->
    <string name="inputs_volume_control_enabled_desc">Control TV/AVR volume instead of internal volume</string>

    <string name="unsupported">Unsupported</string>
</resources>

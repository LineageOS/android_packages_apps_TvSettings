<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wifi_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical">

    <com.android.tv.twopanelsettings.QrCodeView
        android:id="@+id/setup_qrcode_view"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toEndOf="@id/setup_qrcode_guideline"
        app:layout_constraintTop_toTopOf="parent" />

    <com.android.tv.twopanelsettings.SmoothScalingTextView
        android:id="@+id/thread_qr_code_string"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/brand_font"
        android:textColor="#E8EAED"
        android:textSize="24sp"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="@id/setup_qrcode_view"
        app:layout_constraintEnd_toEndOf="@id/setup_qrcode_view"
        app:layout_constraintTop_toBottomOf="@id/setup_qrcode_view" />

    <com.android.tv.twopanelsettings.SmoothScalingTextView
        android:id="@+id/thread_qr_code_countdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:fontFamily="@font/brand_font"
        android:textColor="#959ea7"
        android:textSize="16sp"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="@id/setup_qrcode_view"
        app:layout_constraintEnd_toEndOf="@id/setup_qrcode_view"
        app:layout_constraintTop_toBottomOf="@id/thread_qr_code_string" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginStart="120dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/setup_qrcode_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.android.tv.twopanelsettings.SmoothScalingTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:fontFamily="@font/brand_font"
            android:text="@string/share_thread_title"
            android:textColor="#E8EAED"
            android:textSize="32sp" />

        <com.android.tv.twopanelsettings.SmoothScalingTextView
            android:id="@+id/setup_qrcode_description"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/brand_font"
            android:text="@string/wifi_scan_qr_code_back_description"
            android:textColor="#959ea7"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/setup_qrcode_guideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.55" />

</androidx.constraintlayout.widget.ConstraintLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="@dimen/tp_preference_width"
              android:layout_height="wrap_content"
              android:minHeight="@dimen/tp_preference_min_height"
              android:focusable="true"
              android:descendantFocusability="blocksDescendants"
              android:orientation="horizontal"
              android:clipChildren="false"
              android:layout_marginBottom="@dimen/tp_preference_item_margin_bottom"
              android:paddingTop="@dimen/lb_preference_item_text_space_top"
              android:paddingBottom="@dimen/lb_preference_item_text_space_bottom"
              android:paddingStart="?android:attr/listPreferredItemPaddingStart"
              android:paddingEnd="16dp"
              android:background="@drawable/sensor_physical_privacy_enabled_info_bg_two_panel">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:tint="#FFF9DEDC"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.android.tv.twopanelsettings.SmoothScalingTextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:textColor="#FFF9DEDC"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <com.android.tv.twopanelsettings.SmoothScalingTextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="#FFC27D7A" />
    </LinearLayout>
</LinearLayout>
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "statslog-tvsettings-java-gen",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module tv_settings" +
        " --javaPackage com.android.tv.twopanelsettings.slices --javaClass TvSettingsStatsLog",
    out: ["com/android/tv/twopanelsettings/slices/TvSettingsStatsLog.java"],
}

// This is needed to provide TvSettingsStatsLog as a library for TwoPanelSettingsOverlay makefile.
java_library {
    name: "statslog-tvsettings",
    libs: [
        "androidx.annotation_annotation",
    ],
    srcs: [
        ":statslog-tvsettings-java-gen",
    ],
}

android_library {
    name: "TwoPanelSettingsLib",
    defaults: ["SettingsLibDefaults"],

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],

    resource_dirs: [
        "res",
        "src/com/android/tv/twopanelsettings/slices/compat/res/view",
    ],

    static_libs: [
        "androidx.recyclerview_recyclerview",
        "androidx.preference_preference",
        "androidx.appcompat_appcompat",
        "androidx.legacy_legacy-preference-v14",
        "androidx.leanback_leanback-preference",
        "androidx.leanback_leanback",
        "androidx.lifecycle_lifecycle-extensions",
        "androidx.remotecallback_remotecallback",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-extensions",
        "androidx.lifecycle_lifecycle-common-java8",
        "androidx.cardview_cardview",
        "androidx.slice_slice-builders",
        "androidx.slice_slice-core",
        "androidx.slice_slice-view",
        "error_prone_annotations",
        "kotlin-reflect",
        "statslog-tvsettings",
        "TvSettingsAPI",
        "zxing-core",
    ],
    // TODO(b/319716205): re-enable use_resource_processor
    use_resource_processor: false,
}

filegroup {
    name: "TvSliceLibJavaSrc",
    srcs: [
        "src/com/android/tv/twopanelsettings/slices/SlicesConstants.java",
        "src/com/android/tv/twopanelsettings/slices/TvSettingsSliceProvider.java",
        "src/com/android/tv/twopanelsettings/slices/builders/**/*.java",
        "src/com/android/tv/twopanelsettings/slices/compat/**/*.java",
        "src/com/android/tv/twopanelsettings/slices/base/**/*.java",
    ],
}

filegroup {
    name: "TvSliceLibKotlinSrc",
    srcs: [
        "src/com/android/tv/twopanelsettings/slices/builders/**/*.kt",
        "src/com/android/tv/twopanelsettings/slices/compat/**/*.kt",
        "src/com/android/tv/twopanelsettings/slices/base/**/*.kt",
    ],
}

android_library {
    name: "TvSliceLibDeps",
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.annotation_annotation",
        "androidx.recyclerview_recyclerview",
        "androidx.remotecallback_remotecallback",
        "androidx.slice_slice-builders",
        "androidx.slice_slice-core",
        "androidx.slice_slice-view",
        "error_prone_annotations",
    ],
}

android_library {
    name: "TvSliceLib",
    srcs: [
        ":TvSliceLibJavaSrc",
        ":TvSliceLibKotlinSrc",
    ],

    resource_dirs: [
        "src/com/android/tv/twopanelsettings/slices/compat/res/view",
    ],

    static_libs: [
        "TvSliceLibDeps",
    ],
}

droiddoc {
    name: "TwoPanelSliceLibDocs",
    custom_template: "droiddoc-templates-sdk",
    srcs: [
        ":TvSliceLibJavaSrc",
    ],
    flags: [
        "-offlinemode",
        "-title \"TV Settings Slice Library\"",
    ],
    libs: [
        "TvSliceLibDeps",
    ],
    hdf: [
        "android.whichdoc offline",
        "dac true",
        "sdk.codename V",
        "sdk.preview 0",
        "sdk.preview.version 1",
        "sdk.rel.id 1",
        "sdk.version 16",
    ],
}

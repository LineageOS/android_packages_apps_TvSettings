<manifest xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:tools="http://schemas.android.com/tools"
     package="com.example.updatablesettings">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-sdk android:targetSdkVersion="34"
         android:minSdkVersion="34"/>
    <application android:label="@string/updatable_settings_sample_app_title"
         android:icon="@mipmap/ic_launcher"
         android:theme="@android:style/Theme.Holo.Light.NoActionBar"
         android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true">

        <!-- Protecting provider and activity with WRITE_SECURE_SETTINGS permission prevents
             access from regular apps. If needed, check getCallingPackage() explicitly. -->
        <provider
            android:name=".MainSettingsSliceProvider"
            android:authorities="com.example.updatablesettings.sliceprovider"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.app.slice.category.SLICE"/>
            </intent-filter>
        </provider>

        <activity android:name=".KeystoneCorrectionActivity"
            android:theme="@style/Theme.Leanback"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:exported="true" />

    </application>
</manifest>
